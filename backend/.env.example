# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                 # development | production
SECRET_KEY=change-me-in-production  # refuse to start in production if left default
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=30
DATABASE_URL=sqlite+aiosqlite:///./mandi.db
# For Postgres (production-ready): postgresql+asyncpg://user:pass@host/db
CORS_ORIGINS=http://localhost:3000,https://your-project.vercel.app

# ── OTP ──────────────────────────────────────────────────────────────────────
OTP_PROVIDER=console                # console only; interface allows MSG91/Twilio later
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
DEV_FIXED_OTP=123456                # dev only; refused in production

# ── Agmarknet / data.gov.in ───────────────────────────────────────────────────
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_RESOURCE_ID_ALT=35985678-0d79-46b4-9ed6-6f13308a1d24
PRICE_CACHE_TTL_HOURS=6
PRICE_STALE_DAYS=3                  # older than this => stale=true

# ── LLM (Groq) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_PRIMARY=qwen/qwen3-8b-27b          # verify with probe_apis.py
LLM_MODEL_FALLBACK=llama-3.1-70b-versatile   # fallback if primary unavailable
LLM_MODEL_SMALL=llama-3.1-8b-instant         # numeric/simple agents
LLM_CONCURRENCY=2
LLM_MAX_RETRIES=4
LLM_TIMEOUT_SECONDS=45

# ── Sarvam ───────────────────────────────────────────────────────────────────
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=meera
VOICE_MAX_SECONDS=30
VOICE_STT_PER_USER_PER_DAY=30
VOICE_TTS_PER_USER_PER_DAY=20

# ── Other upstreams ──────────────────────────────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=MandiSabha/0.1 (contact: admin@mandisabha.example.com)

# ── Rate limits (per user unless noted) ──────────────────────────────────────
RL_GENERAL_PER_MIN=60
RL_SABHA_CREATE_PER_HOUR=10
RL_OTP_PER_PHONE_PER_10MIN=3
RL_OTP_PER_IP_PER_10MIN=10

# ── Economics (all disclosed in payloads) ────────────────────────────────────
RETURN_LEG_FACTOR=2.0
VEHICLE_CAPACITY_Q={"pickup":15,"truck":60,"heavy":150}
VEHICLE_DEFAULT_RATE_PER_KM={"pickup":14,"truck":28,"heavy":40}
LOADING_COST_PER_Q=0
COMMISSION_PCT=0
TOLL_PER_KM=0
GRADE_MULTIPLIERS={"A":1.05,"B":1.0,"C":0.92}
MAX_CANDIDATE_MANDIS=5

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
